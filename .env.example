# ─── הגדרות הצוות (the 5 agents) ───
# העתק קובץ זה ל-.env ומלא את הערכים האמיתיים.
# אל תעלה את .env ל-Git! (הוא מוחרג ב-.gitignore)

# מפתח ה-API של Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# המודל שבו הצוות משתמש כברירת מחדל
ANTHROPIC_MODEL=claude-opus-4-8

# (אופציונלי) מפתחות נוספים לסוכנים — חקר / תמונות וכו'
# מפתח לחיפוש/מחקר עבור חן (החוקרת)
SEARCH_API_KEY=

# מפתח ליצירת תמונות עבור יובל (מעצב התמונות)
IMAGE_API_KEY=

# מפתח OpenAI ליצירת תמונות — יובל משתמש בו דרך הסקיל gpt-image-gen (מודל gpt-image-2)
OPENAI_API_KEY=your-openai-api-key-here
